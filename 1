  LED pin numbers
int ledPins[] = {2, 3, 4, 5, 6};
int numLeds = 5;
void setup() {
// Set all LED pins as output
for (int i = 0; i < numLeds; i++) {
pinMode(ledPins[i], OUTPUT);
}
}
void loop() {
// Forward direction (left to right)
for (int i = 0; i < numLeds; i++) {
turnOnOnly(i);
delay(150);
}
// Backward direction (right to left)
for (int i = numLeds - 2; i > 0; i--) { // avoid repeating the first and last LED
turnOnOnly(i);
delay(150);
}
}
// Function to turn on one LED and turn off the rest
void turnOnOnly(int ledIndex) {
for (int i = 0; i < numLeds; i++) {
digitalWrite(ledPins[i], i == ledIndex ? HIGH : LOW);
}
